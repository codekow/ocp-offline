{
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "commit": false,
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "tls": {
      "cert": "/etc/zot/localhost.crt",
      "key": "/etc/zot/localhost.key"
    },
    "realm": "zot",
    "compat": ["docker2s2"]
  },
  "log": {
    "level": "info",
    "output": "/var/lib/registry/zot-main.log",
    "audit": "/var/lib/registry/zot-audit.log"
  },
  "extensions": {
    "search": {
      "enable": true,
      "cve": {
        "updateInterval": "4h"
      }
    },
    "ui": {
      "enable": true
    },
    "mgmt": {
      "enable": true
    }
  }
}
